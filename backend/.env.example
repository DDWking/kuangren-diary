# 狂人日记后端环境变量示例
# 复制为 backend/.env 后按需修改（.env 已在 .gitignore 中，不会被提交）

# 必填：API Bearer Token。生产环境务必换成随机长字符串，不要提交真实值。
KUANGREN_TOKEN=change-me

# 数据目录：默认 backend/data，SQLite 文件落在 <data_dir>/kuangren.db；重启不丢数据
KUANGREN_DATA_DIR=./data

# 可选：直接指定 SQLite 文件路径（优先级高于 KUANGREN_DATA_DIR）
# KUANGREN_DB_PATH=./data/kuangren.db

# 可选：完整 SQLAlchemy 连接串（优先级最高，便于以后换 Postgres）
# KUANGREN_DATABASE_URL=sqlite:///./data/kuangren.db

# 监听：生产默认 0.0.0.0:8090 给 Caddy 反代；本地自测可改成 127.0.0.1
KUANGREN_HOST=0.0.0.0
KUANGREN_PORT=8090

# 设备在线上报阈值（秒），默认 90
KUANGREN_ONLINE_SECONDS=90
